Screen {
    background: $surface;
}

#status-bar {
    height: 1;
    background: $primary;
    color: $text;
    padding: 0 1;
}

#sim-banner {
    height: 1;
    background: $warning;
    color: $text;
    text-align: center;
    display: none;
}

#sim-banner.visible {
    display: block;
}

ZoneCard {
    height: 7;
    border: solid $primary;
    margin: 0 1 1 1;
    padding: 0 1;
}

ZoneCard.critical {
    border: solid $error;
}

ZoneCard.irrigating {
    border: solid $success;
}

#alerts-list {
    height: 100%;
    overflow-y: auto;
}

.alert-critical {
    color: $error;
}

.alert-warning {
    color: $warning;
}

.alert-info {
    color: $primary;
}

#moisture-bar {
    width: 20;
}

TabbedContent {
    height: 1fr;
}
