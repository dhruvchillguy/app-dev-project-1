Screen {
    background: $surface;
}

#status-bar {
    height: 1;
    background: $primary;
    color: $text;
    padding: 0 1;
}

#sim-banner {
    height: 1;
    background: $warning;
    color: $text;
    text-align: center;
    display: none;
}

#sim-banner.visible {
    display: block;
}

#zone-table {
    height: 6;
    margin: 0 1;
}

#weather-panel {
    height: 2;
    padding: 0 1;
    color: $accent;
}

#alerts-feed {
    height: 1fr;
    padding: 0 1;
    overflow-y: auto;
}

TabbedContent {
    height: 1fr;
}
