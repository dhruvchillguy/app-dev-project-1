{
  "name": "sinchai",
  "version": "1.0.0",
  "type": "module",
  "bin": {
    "sinchai": "./src/cli.js"
  },
  "scripts": {
    "start": "node --no-warnings --import tsx src/index.js run",
    "demo": "node --no-warnings --import tsx src/index.js run --demo",
    "headless": "node --no-warnings --import tsx src/index.js run --headless --demo",
    "mcp": "node --no-warnings src/mcp-server.js",
    "doctor": "node --no-warnings --import tsx src/index.js doctor",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "ink": "^6.0.0",
    "react": "^19.2.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "ink-testing-library": "^4.0.0",
    "tsx": "^4.19.0",
    "vitest": "^3.0.0"
  },
  "optionalDependencies": {
    "serialport": "^13.0.0"
  }
}
